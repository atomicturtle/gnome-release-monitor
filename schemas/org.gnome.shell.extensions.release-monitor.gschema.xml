<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="release-monitor">
  <schema id="org.gnome.shell.extensions.release-monitor" path="/org/gnome/shell/extensions/release-monitor/">
    <key name="refresh-interval" type="i">
      <default>1800</default>
      <summary>Refresh interval in seconds</summary>
